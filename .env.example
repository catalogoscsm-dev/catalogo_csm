# ── APIs ──────────────────────────────────────────────────────────────────
# Claude (detecção de bboxes + extração de dados — uma chave só)
ANTHROPIC_API_KEY=sk-ant-...

# ── Web App ────────────────────────────────────────────────────────────────
SECRET_KEY=troque-por-uma-chave-aleatoria-segura
ADMIN_PASSWORD=senha-do-admin
CLIENT_PASSWORD=senha-dos-clientes

# ── Configurações opcionais do extractor ──────────────────────────────────
# DPI de conversão dos PDFs (200 é bom equilíbrio qualidade/velocidade)
DPI=200

# Número de cores dominantes extraídas por produto
NUM_CORES_PALETA=5

# Delay em segundos entre páginas (respeita rate limits)
DELAY_ENTRE_PAGINAS=1.2
